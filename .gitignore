# Dependencies
node_modules/

# Build output. dist/linear.js is the published bin, but it is a 2 MB esbuild
# bundle regenerated by `npm run build` — keep it out of history.
dist/

# Never commit credentials. The API key lives in ~/.config/linear-cli/config.json
# (outside the repo) but guard against a stray copy landing here.
config.json
.env
.env.*
*.pem
*.key

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Logs and scratch
*.log
npm-debug.log*
.npm/
coverage/
*.tsbuildinfo
